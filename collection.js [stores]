function generateValueHistory(startVal, endVal, months = 12) {
  const data = []
  for (let i = 0; i < months; i++) {
    const progress = i / (months - 1)
    const base = startVal + (endVal - startVal) * progress
    const noise = (Math.random() - 0.5) * base * 0.1
    data.push(Math.round(base + noise))
  }
  return data
}

export const useCollectionStore = defineStore('collection', () => {
  const records = ref(DEMO_COLLECTION.map(r => ({
    ...r,
    valueHistory: generateValueHistory(Math.round(r.currentValue * 0.6), r.currentValue)
  })))

  const wantList = ref([
    { id: 101, title: 'Music Has the Right to Children', artist: 'Boards of Canada', year: 1998, genre: 'Electronic', estValue: 120, priority: 'high', notes: 'Been hunting this for 2 years' },
    { id: 102, title: 'For All We Know', artist: 'Donny Hathaway', year: 1970, genre: 'Soul', estValue: 45, priority: 'medium', notes: 'Original pressing preferred' },
    { id: 103, title: 'Loveless', artist: 'My Bloody Valentine', year: 1991, genre: 'Shoegaze', estValue: 200, priority: 'high', notes: 'Original Creation Records pressing' },
    { id: 104, title: 'Endtroducing...', artist: 'DJ Shadow', year: 1996, genre: 'Hip-Hop', estValue: 80, priority: 'low', notes: '' },
  ])

  const settings = ref({ discogsUsername: '', discogsToken: '', openWeatherKey: '', currency: 'EUR' })
  const currentView = ref('dashboard')

  const totalValue = computed(() => records.value.reduce((s, r) => s + r.currentValue, 0))
  const totalCost = computed(() => records.value.reduce((s, r) => s + r.purchasePrice, 0))
  const totalProfit = computed(() => totalValue.value - totalCost.value)
  const profitPercent = computed(() => totalCost.value > 0 ? ((totalProfit.value / totalCost.value) * 100).toFixed(1) : 0)

  const genreBreakdown = computed(() => {
    const map = {}
    records.value.forEach(r => { map[r.genre] = (map[r.genre] || 0) + r.currentValue })
    return Object.entries(map).sort((a, b) => b[1] - a[1]).map(([genre, value]) => ({ genre, value }))
  })

  const mostPlayedRecords = computed(() => [...records.value].sort((a, b) => b.plays - a.plays).slice(0, 5))
  const newestRecords = computed(() => [...records.value].sort((a, b) => new Date(b.purchaseDate) - new Date(a.purchaseDate)).slice(0, 5))
  const topGainers = computed(() =>
    [...records.value]
      .map(r => ({ ...r, gain: r.currentValue - r.purchasePrice, gainPct: ((r.currentValue - r.purchasePrice) / r.purchasePrice * 100).toFixed(1) }))
      .sort((a, b) => b.gainPct - a.gainPct).slice(0, 5)
  )
  const collectionValueHistory = computed(() => {
    const totals = Array(12).fill(0)
    records.value.forEach(r => { r.valueHistory.forEach((v, i) => { totals[i] += v }) })
    return totals
  })

  function addToWantList(item) { wantList.value.push({ ...item, id: Date.now() }) }
  function removeFromWantList(id) { wantList.value = wantList.value.filter(w => w.id !== id) }
  function markAsOwned(id) { wantList.value = wantList.value.filter(w => w.id !== id) }
  function incrementPlays(id) { const r = records.value.find(r => r.id === id); if (r) r.plays++ }

  return {
    records, wantList, settings, currentView,
    totalValue, totalCost, totalProfit, profitPercent,
    genreBreakdown, mostPlayedRecords, newestRecords, topGainers, collectionValueHistory,
    addToWantList, removeFromWantList, markAsOwned, incrementPlays
  }
})

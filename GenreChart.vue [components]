<template>
  <div class="card fade-in">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.25rem;">
      <div><div class="stat-label">Genre Breakdown</div><div style="font-weight:700; font-size:1.1rem;">{{ store.records.length }} Records</div></div>
      <div style="display:flex; gap:0.4rem;">
        <button class="btn-secondary" :style="mode==='value'?'background:rgba(124,58,237,0.25);border-color:rgba(124,58,237,0.5);color:white;':''" @click="mode='value'">Value</button>
        <button class="btn-secondary" :style="mode==='count'?'background:rgba(124,58,237,0.25);border-color:rgba(124,58,237,0.5);color:white;':''" @click="mode='count'">Count</button>
      </div>
    </div>
    <div style="display:flex; gap:1.5rem; align-items:center;">
      <div style="width:160px; height:160px; flex-shrink:0; position:relative;">
        <canvas ref="chartCanvas"></canvas>
        <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);text-align:center;pointer-events:none;">
          <div style="font-size:0.6rem; color:rgba(255,255,255,0.4); text-transform:uppercase; letter-spacing:0.06em;">Total</div>
          <div style="font-weight:800; font-size:1rem; line-height:1.1;">{{ mode === 'value' ? '€'+formatNum(store.totalValue) : store.records.length }}</div>
        </div>
      </div>
      <div style="flex:1; display:flex; flex-direction:column; gap:0.4rem;">
        <div v-for="(item, i) in chartData" :key="item.label" style="display:flex; align-items:center; gap:0.6rem; cursor:pointer;" @mouseenter="highlight(i)" @mouseleave="unhighlight()">
          <div style="width:10px; height:10px; border-radius:2px; flex-shrink:0;" :style="{ background: COLORS[i % COLORS.length] }"></div>
          <div style="flex:1; font-size:0.8rem; color:rgba(255,255,255,0.8);">{{ item.label }}</div>
          <div style="font-size:0.8rem; font-weight:600;">{{ mode === 'value' ? '€'+formatNum(item.value) : item.count }}</div>
          <div style="font-size:0.7rem; color:rgba(255,255,255,0.4);">{{ item.pct }}%</div>
        </div>
      </div>
    </div>
  </div>
</template>

<script setup>
import { ref, onMounted, watch, computed } from 'vue'
import { Chart, registerables } from 'chart.js'
import { useCollectionStore } from '../stores/collection.js'

Chart.register(...registerables)
const store = useCollectionStore()
const chartCanvas = ref(null)
let chartInstance = null
const mode = ref('value')
const COLORS = ['#a78bfa','#f472b6','#fb923c','#34d399','#60a5fa','#fbbf24','#f87171','#818cf8']

const chartData = computed(() => {
  const map = {}
  store.records.forEach(r => { if (!map[r.genre]) map[r.genre] = { label: r.genre, value: 0, count: 0 }; map[r.genre].value += r.currentValue; map[r.genre].count++ })
  const total = mode.value === 'value' ? store.records.reduce((s, r) => s + r.currentValue, 0) : store.records.length
  return Object.values(map).sort((a, b) => b[mode.value === 'value' ? 'value' : 'count'] - a[mode.value === 'value' ? 'value' : 'count']).map(item => ({ ...item, pct: Math.round((item[mode.value === 'value' ? 'value' : 'count'] / total) * 100) }))
})

function formatNum(n) { return Math.round(n).toLocaleString('nl-NL') }

function buildChart() {
  if (!chartCanvas.value) return
  const ctx = chartCanvas.value.getContext('2d')
  if (chartInstance) chartInstance.destroy()
  const data = chartData.value
  chartInstance = new Chart(ctx, {
    type: 'doughnut',
    data: { labels: data.map(d => d.label), datasets: [{ data: data.map(d => mode.value === 'value' ? d.value : d.count), backgroundColor: COLORS.map(c => c + 'cc'), borderColor: COLORS, borderWidth: 1.5, hoverOffset: 6 }] },
    options: { responsive: true, maintainAspectRatio: false, cutout: '68%', plugins: { legend: { display: false }, tooltip: { backgroundColor: 'rgba(15,15,20,0.95)', borderColor: 'rgba(124,58,237,0.4)', borderWidth: 1, titleColor: 'white', bodyColor: 'rgba(255,255,255,0.7)', padding: 10, callbacks: { label: ctx => mode.value === 'value' ? ` €${Math.round(ctx.raw).toLocaleString('nl-NL')}` : ` ${ctx.raw} records` } } } }
  })
}

function highlight(i) { if (!chartInstance) return; chartInstance.data.datasets[0].backgroundColor = COLORS.map((c, j) => j === i ? c : c + '33'); chartInstance.update('none') }
function unhighlight() { if (!chartInstance) return; chartInstance.data.datasets[0].backgroundColor = COLORS.map(c => c + 'cc'); chartInstance.update('none') }

onMounted(buildChart)
watch(mode, buildChart)
watch(() => store.records, buildChart, { deep: true })
</script>

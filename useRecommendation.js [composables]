import { computed } from 'vue'

export function useRecommendation(records, weather, timeMood, heartRate) {
  const BPM_ZONES = {
    rest:    { min: 0,   max: 70,  label: 'Resting',    icon: '🛋️', targetBpm: [60, 100],  moods: ['chill','ambient','introspective'] },
    easy:    { min: 70,  max: 100, label: 'Easy',       icon: '🚶', targetBpm: [90, 120],  moods: ['chill','focused','morning'] },
    moderate:{ min: 100, max: 130, label: 'Active',     icon: '🏃', targetBpm: [110, 135], moods: ['energetic','focused','afternoon'] },
    intense: { min: 130, max: 160, label: 'Intense',    icon: '🔥', targetBpm: [125, 145], moods: ['energetic','party','workout'] },
    max:     { min: 160, max: 999, label: 'Max effort', icon: '⚡', targetBpm: [140, 175], moods: ['energetic','party','dark'] },
  }

  function getHrZone(hr) {
    if (!hr || hr < 40) return null
    return Object.values(BPM_ZONES).find(z => hr >= z.min && hr < z.max) || null
  }

  function scoreRecord(record, weatherData, timeData, hr) {
    let score = 0
    const reasons = []
    const weatherMood = weatherData?.mood || 'chill'
    const timePeriod  = timeData?.period  || 'evening'
    const hrZone      = getHrZone(hr)

    if (record.mood?.includes(weatherMood)) {
      score += 40
      reasons.push({ icon: weatherData?.icon || '🌡️', text: `Matches ${weatherData?.label || 'current'} weather vibes` })
    } else if (record.mood?.includes('chill') && ['cloudy','misty'].includes(weatherMood)) {
      score += 20
      reasons.push({ icon: '☁️', text: 'Works for overcast Rotterdam skies' })
    }

    if (record.timeOfDay?.includes(timePeriod)) {
      score += 30
      reasons.push({ icon: timeData?.icon || '🕐', text: `Perfect for ${timeData?.label || 'now'}` })
    }

    if (hrZone) {
      const bpmMatch = record.bpm >= hrZone.targetBpm[0] && record.bpm <= hrZone.targetBpm[1]
      const moodMatch = hrZone.moods.some(m => record.mood?.includes(m))
      if (bpmMatch && moodMatch) {
        score += 20
        reasons.push({ icon: hrZone.icon, text: `BPM syncs with your ${hrZone.label.toLowerCase()} heart rate` })
      } else if (bpmMatch || moodMatch) {
        score += 10
        reasons.push({ icon: '💓', text: `Good energy match for HR ${hr}bpm` })
      }
    }

    const daysSinceBought = (Date.now() - new Date(record.purchaseDate).getTime()) / 86400000
    const playsPerDay = record.plays / Math.max(daysSinceBought, 1)
    if (playsPerDay < 0.05) {
      score += 10
      reasons.push({ icon: '💿', text: `You haven't spun this in a while` })
    }

    if (weatherMood === 'rainy' && ['Trip-Hop','Post-Punk','Electronic'].includes(record.genre)) {
      score += 5
      reasons.push({ icon: '🎵', text: `${record.genre} + Rotterdam rain = perfection` })
    }
    if (timePeriod === 'morning' && record.genre === 'Jazz') {
      score += 5
      reasons.push({ icon: '☕', text: 'Morning jazz — classic combo' })
    }
    if (timePeriod === 'late night' && record.genre === 'Electronic') {
      score += 5
      reasons.push({ icon: '🌃', text: 'Late night electronics hit different' })
    }

    return { score, reasons }
  }

  const recommendations = computed(() => {
    if (!records.value?.length) return []
    return records.value
      .map(record => {
        const { score, reasons } = scoreRecord(record, weather?.value, timeMood?.value, heartRate?.value)
        return { ...record, score, reasons }
      })
      .sort((a, b) => b.score - a.score)
      .slice(0, 5)
  })

  const topPick = computed(() => recommendations.value[0] || null)
  function getHrZoneInfo(hr) { return getHrZone(hr) }
  return { recommendations, topPick, getHrZoneInfo, BPM_ZONES }
}

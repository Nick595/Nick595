<script setup>
import { ref } from 'vue'
import { useCollectionStore } from '../stores/collection.js'

const store = useCollectionStore()
const weatherStatus = ref(null)

async function testWeather() {
  if (!store.settings.openWeatherKey) return
  try {
    const res = await fetch(`https://api.openweathermap.org/data/2.5/weather?lat=51.9225&lon=4.4792&appid=${store.settings.openWeatherKey}&units=metric`)
    if (res.ok) {
      const d = await res.json()
      weatherStatus.value = { ok: true, msg: `✓ Connected! Rotterdam: ${Math.round(d.main.temp)}°C, ${d.weather[0].description}` }
    } else {
      weatherStatus.value = { ok: false, msg: '✗ Invalid API key' }
    }
  } catch {
    weatherStatus.value = { ok: false, msg: '✗ Connection failed' }
  }
}
</script>

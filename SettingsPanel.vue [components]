          <span v-else class="badge badge-amber" style="margin-left:auto;">Demo mode</span>
        </div>
        <div>
          <label class="stat-label" style="display:block;margin-bottom:0.3rem;">OpenWeatherMap API Key</label>
          <div style="display:flex;gap:0.5rem;">
            <input v-model="store.settings.openWeatherKey" class="input-dark" type="password" placeholder="Free key from openweathermap.org"/>
